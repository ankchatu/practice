pipeline {
    agent any

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/ankchatu/practice.git'
            }
        }

        stage('Build Maven Project') {
            steps {
                dir('Sample_App_Docker_ECS') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Archive JAR') {
            steps {
                archiveArtifacts artifacts: 'Sample_App_Docker_ECS/target/*.jar', fingerprint: true
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Sample_App_Docker_ECS') {
                    bat 'docker build -t sample-ecs-app .'
                }
            }
        }

        stage('Run Container (Test)') {
            steps {
                bat 'docker run -d -p 8080:8080 --name sample-container sample-ecs-app'
            }
        }
    }

    post {
        always {
            // Stop and delete container if already running
            bat 'docker stop sample-container || echo "Container not running"'
            bat 'docker rm sample-container || echo "Container already removed"'
        }
    }
}
